{
  // Internal template for pdfoenix's model adapter.  NOT user configuration.
  //
  // Every book's ``working/opencode.jsonc`` is generated from this file plus
  // the [[expt.provider]] / [[expt.combo]] entries in the book's config.toml.
  // Users configure models and gateways in config.toml only; the generated
  // file is an artifact and must not be edited.
  //
  // The two agents below are deliberately tool-free: page images arrive as
  // attachments and every answer must be returned as text on stdout.
  "$schema": "https://opencode.ai/config.json",
  "snapshots": false,
  "agents": {
    "pdfoenix-transcribe": {
      "description": "Transcribe attached page scans into Markdown. Text output only.",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    },
    "pdfoenix-verify": {
      "description": "Audit a Markdown transcription against page scans. JSON output only.",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
